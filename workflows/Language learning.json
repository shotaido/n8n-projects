      "position": [688, 480],
      "id": "groq-model-secondary",
      "name": "Groq Chat Model1"
    },
    {
      "parameters": {
        "model": "openai/gpt-oss-safeguard-20b"
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [816, 480],
      "id": "groq-fallback-parser",
      "name": "Groq Chat Model2"
    },
    {
      "parameters": {
        "jsCode": "const rawText = $json.output; \nconst cleanText = rawText.replace(/```text|```/g, '').trim();\nconst lines = cleanText.split('\\n');\nconst result = {};\nlines.forEach(line => {\n  const [key, ...valueParts] = line.split(':');\n  if (key && valueParts.length > 0) {\n    result[key.trim()] = valueParts.join(':').trim();\n  }\n});\nreturn result;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1024, 256],
      "id": "js-parser",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "dataTableId": {
          "__rl": true,
          "value": "vocabulary_store_id",
          "mode": "list"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "English": "={{ $json['\"word_en\"'] }}",
            "Kannada": "={{ $json['\"word_ka\"'] }}",
            "Japanese": "={{ $json['\"word_ja\"'] }}",
            "Korean": "={{ $json['\"word_kr\"'] }}"
          }
        }
