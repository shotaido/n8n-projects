    {
      "parameters": {
        "promptType": "define",
        "text": "=- Task: Parse the words in key-value form\n- Output: keys should be word_en, word_ka, word_ja, word_kr. These represent English, Kannada, Japanese, Korean respectively\n- Input: {{ $json.output }}",
        "needsFallback": true
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [672, 256],
      "id": "ai-agent-parser",
