{
  "name": "Weather forecast - Showcase version",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 9,
              "triggerAtMinute": 45
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [0, 0],
      "id": "schedule-trigger",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "url": "https://api.weather.gov/gridpoints/MTR/99,82/forecast",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "(my-weather-app)"
            }
          ]
        },
        "options": {
          "redirect": {
            "redirect": {}
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [208, 0],
      "id": "weather-api-fetch",
      "name": "HTTP Request"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Tell me the following:\n- what the weather forecast is for the day\n- what I should wear if I am heading outside in 1 hour. Here is the API docs for reference: https://swagger.io/specification/\n\nBelow is the API response of the weather forcast of where I live\n{{ $json.data }}\n\nThe response should mention both fahrenheit and celcius (in parentheses)",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [416, 0],
      "id": "ai-agent",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "model": "openai/gpt-oss-120b",
        "options": {
          "temperature": 0.1
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [416, 208],
      "id": "groq-model",
      "name": "Groq Chat Model"
    },
    {
      "parameters": {
        "mode": "markdownToHtml",
        "markdown": "={{ $json.output }}",
        "options": {
          "tables": true
        }
      },
      "type": "n8n-nodes-base.markdown",
      "typeVersion": 1,
      "position": [768, 0],
      "id": "markdown-to-html",
      "name": "Markdown"
    },
    {
      "parameters": {
        "sendTo": "recipient1@example.com, recipient2@example.com",
        "subject": "=Weather forecast & what to wear ({{ $('Schedule Trigger').item.json['Day of week'] }}, {{ $('Schedule Trigger').item.json.Month }} {{ $('Schedule Trigger').item.json['Day of month'] }})",
        "message": "={{ $json.data.replace(/<table>/g, '<table style=\"width:100%; border-collapse:collapse; border:1px solid #333; font-family:sans-serif;\">').replace(/<td>/g, '<td style=\"border:1px solid #333; padding:8px;\">').replace(/<th>/g, '<th style=\"border:1px solid #333; padding:8px; background-color:#f2f2f2;\">') }}",
        "options": {}
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [976, 0],
      "id": "gmail-sender",
      "name": "Send a message"
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [[{"node": "HTTP Request", "type": "main", "index": 0}]]
    },
    "HTTP Request": {
      "main": [[{"node": "AI Agent", "type": "main", "index": 0}]]
    },
    "Groq Chat Model": {
      "ai_languageModel": [[{"node": "AI Agent", "type": "ai_languageModel", "index": 0}]]
    },
    "AI Agent": {
      "main": [[{"node": "Markdown", "type": "main", "index": 0}]]
    },
    "Markdown": {
      "main": [[{"node": "Send a message", "type": "main", "index": 0}]]
    }
  }
}